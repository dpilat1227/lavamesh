# Copy to .env.local for development. Set the same keys on the Vercel project
# for production. Never commit real values.

# ── Database (app uses POSTGRES_URL; Prisma CLI falls back to DATABASE_URL) ──
POSTGRES_URL=
# DATABASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.lavamesh.com
# Required in production for password login (ADMIN_PASSWORD is also accepted).
AUTH_PASSWORD=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Use a verified domain. EMAIL_FROM must not be onboarding@resend.dev in production.
RESEND_API_KEY=
EMAIL_FROM=LavaMesh <alerts@lavamesh.com>
ADMIN_EMAIL=drew@lavamesh.com

# ── Vercel KV / Redis ─────────────────────────────────────────────────────────
# Required for license paste, audit log, backups, API keys, notification config.
KV_REDIS_URL=

# ── Headscale ─────────────────────────────────────────────────────────────────
HEADSCALE_API_URL=
HEADSCALE_API_KEY=
HEADSCALE_PUBLIC_URL=

# Billing env vars are unused. The dashboard is free.
# PROVISIONING_SECRET=
# FLY_API_TOKEN=
# FLY_ORG_SLUG=
# FLY_REGION=iad
# CRON_SECRET=

# ── Admin OIDC (optional). Password + magic link still work without these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
