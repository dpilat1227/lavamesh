# Copy to .env.local for development. Set the same keys on the Vercel project
# for production. Never commit real values.

# ── Database (Prisma uses POSTGRES_URL) ───────────────────────────────────────
POSTGRES_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.lavamesh.com
# Required in production for password login. Without it, only magic-link email works.
AUTH_PASSWORD=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Use a verified domain. EMAIL_FROM must not be onboarding@resend.dev in production.
RESEND_API_KEY=
EMAIL_FROM=LavaMesh <alerts@lavamesh.com>
ADMIN_EMAIL=drew@lavamesh.com

# ── Vercel KV / Redis ─────────────────────────────────────────────────────────
# Required for license paste, audit log, backups, API keys, notification config.
KV_REDIS_URL=

# ── Headscale ─────────────────────────────────────────────────────────────────
HEADSCALE_API_URL=
HEADSCALE_API_KEY=
HEADSCALE_PUBLIC_URL=

# ── Pro license (optional instance-wide unlock; skip KV paste) ────────────────
# LAVAMESH_LICENSE_KEY=

# ── Stripe Payment Links (Pro). Public URLs; baked-in fallbacks exist in code.
NEXT_PUBLIC_STRIPE_MONTHLY_LINK=
NEXT_PUBLIC_STRIPE_LIFETIME_LINK=

# ── Cloud (waitlisted). Leave unset until Fly provisioning is ready to charge.
# CLOUD_CHECKOUT_ENABLED=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_CLOUD=
# PROVISIONING_SECRET=
# FLY_API_TOKEN=
# FLY_ORG_SLUG=
# FLY_REGION=iad
# CRON_SECRET=
