generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  tenants       TenantUser[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id               String   @id @default(cuid())
  name             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            TenantUser[]
  headscaleInstance HeadscaleInstance?
  subscription      Subscription?
  nodeStatusLogs    NodeStatusLog[]
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model HeadscaleInstance {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  url           String
  apiKey        String
  // Provisioning lifecycle — set by /api/provision and polled/updated by
  // /api/cron/cloud-status. 'provisioning' until the Fly Machine boots and
  // the Headscale API key callback lands; 'active' once apiKey is usable;
  // 'error' if Fly isn't configured, boot fails, or provisioning times out.
  status        String    @default("provisioning")
  errorMessage  String?   @db.Text
  flyAppName    String?
  flyMachineId  String?
  flyVolumeId   String?
  region        String?
  provisionedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  stripeCustomerId     String
  stripeSubscriptionId String   @unique
  status               String
  plan                 String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model NodeStatusLog {
  id        String   @id @default(cuid())
  machineId String
  tenantId  String
  isOnline  Boolean
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, machineId])
  @@index([createdAt])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Issued automatically by the Stripe webhook the moment a Pro Payment Link
// purchase completes (see app/api/webhooks/stripe/route.ts) — the customer
// gets their key by email within seconds instead of waiting on a human to
// notice the payment and reply manually. Kept here purely as a record for
// support/resend lookups; activation itself still checks the pasted key's
// presence in KV per lib/billing.ts, not against this table.
model LicenseKey {
  id               String   @id @default(cuid())
  key              String   @unique
  email            String
  plan             String // 'monthly' | 'lifetime'
  stripeSessionId  String   @unique
  stripeCustomerId String?
  emailedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([email])
}

